datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  admin_id         String  @id @unique @default(cuid())
  admin_first_name String
  admin_last_name  String
  admin_email      String  @unique
  admin_password   String
  is_active        Boolean @default(true)
  is_deleted       Boolean @default(false)
}

model Curtain {
  curtain_id          String          @id @unique @default(cuid())
  curtain_name        String
  curtain_image_url   String
  curtain_base_price  Float
  curtain_category    CurtainCategory @default(Flat)
  is_active           Boolean         @default(true)
  is_deleted          Boolean         @default(false)
  curtain_description String
  created_at          DateTime        @default(now())
  colorColor_id       String
  curtain_color       Color           @relation(fields: [colorColor_id], references: [color_id])
}

model Color {
  color_id   String    @id @unique @default(cuid())
  color_name String
  is_deleted Boolean   @default(false)
  Curtain    Curtain[]
}

model Visitor {
  visitor_id  String   @id @unique @default(cuid())
  telegram_id String
  created_at  DateTime @default(now())
}

enum CurtainCategory {
  Flat
  Patterned
}
